# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never get committed, but the template must be
.env*
!.env.example

# local SQLite database from the phase-1 prototype
*.db
*.db-journal

# Agent/editor tooling generated by `prisma init` — regenerable, and specific
# to whichever assistant the developer happens to use.
/.claude/skills/
/.windsurf/
/.agents/
/skills-lock.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Uploaded product images (local disk driver, development only)
/public/uploads/
